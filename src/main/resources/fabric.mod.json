{
	"schemaVersion": 1,
	"id": "advancements-refined",
	"version": "${version}",
	"name": "Advancements Refined",
	"description": "Client-side UI and quality-of-life overhaul for advancements: fullscreen tree with zoom, interactive criteria inspector, HUD tracking, and progress bars.",
	"authors": [
		"dmystery"
	],
	"contact": {
	"homepage": "https://github.com/dmystery908-jpg/Advancement-Refined-mod",
	"sources": "https://github.com/dmystery908-jpg/Advancement-Refined-mod",
	"issues": "https://github.com/dmystery908-jpg/Advancement-Refined-mod/issues"
	},
	"license": "MIT",
	"icon": "assets/advancements-refined/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.dmystery.AdvancementProgressClient"
		],
		"modmenu": [
			"com.dmystery.client.ModMenuIntegration"
		]
	},
	"mixins": [
		"advancements-refined.mixins.json"
	],
	"accessWidener": "advancements-refined.accesswidener",
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": ">=26.1 <=26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}