{
	"schemaVersion": 1,
	"id": "advancements-refined",
	"version": "${version}",
	"name": "Advancements Refined",
	"description": "Client-side advancement progress tracking mod for Minecraft.",
	"authors": [
		"dmystery"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "MIT",
	"icon": "assets/advancements-refined/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.dmystery.AdvancementProgressClient"
		],
		"modmenu": [
			"com.dmystery.client.ModMenuIntegration"
		]
	},
	"mixins": [
		"advancements-refined.mixins.json"
	],
	"accessWidener": "advancements-refined.accesswidener",
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": ">=26.1 <=26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}